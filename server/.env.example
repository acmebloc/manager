# DEPLOY.md 2-2 단계에서 만든 전용 계정(manager_app)의 비밀번호로 교체
DATABASE_URL="postgresql://manager_app:PASSWORD@database-1.c9qa8wsawth3.ap-northeast-2.rds.amazonaws.com:5432/manager"

# 프론트엔드 .env의 VITE_GOOGLE_CLIENT_ID와 동일한 값
GOOGLE_CLIENT_ID=240689976296-931102cla566kf3serovkqtqotm2d09t.apps.googleusercontent.com

# 서버가 자체 발급하는 로그인 토큰 서명용 비밀키 (반드시 무작위 긴 문자열로 교체)
JWT_SECRET=change-me-to-a-long-random-string

# User 테이블의 email/name/picture를 애플리케이션 레벨에서 암호화하는 키.
# 반드시 `openssl rand -hex 32`로 생성한 32바이트(64자리 hex) 값으로 교체
FIELD_ENCRYPTION_KEY=change-me-to-a-32-byte-hex-string

# 프론트엔드가 배포될 origin (CORS 허용용). 로컬 개발 중엔 http://localhost:5173
FRONTEND_ORIGIN=https://manager.acmebloc.com

PORT=4000

# --- OIDC Provider (BookStack 등 외부 서비스가 Manager 로그인을 그대로 신뢰하게 함) ---
# 이 값 자체가 issuer가 되고, /.well-known/openid-configuration 이 여기 붙어서 노출됨
OIDC_ISSUER=https://manager.acmebloc.com/oidc
# 아래 두 값은 openssl rand -hex 32 로 생성해서 BookStack .env의 OIDC_CLIENT_ID/SECRET과 동일하게 맞출 것
OIDC_CLIENT_ID=change-me
OIDC_CLIENT_SECRET=change-me
# BookStack이 서브디렉토리(/board)에 설치된다는 전제. BookStack이 고정으로 기대하는 콜백 경로.
OIDC_REDIRECT_URI=https://manager.acmebloc.com/board/oidc/callback

# --- 이메일 알림 (docs/email-notifications-spec.md) ---
# Google Workspace SMTP 릴레이. 로컬 개발 등 SMTP_HOST가 없는 환경에서는 실제
# 발송 대신 콘솔에 로그만 남긴다 — 이 값들은 배포 서버에만 채우면 됨.
# 사전 조건: 릴레이 허용 목록에 이 서버의 고정 퍼블릭 IP(15.164.69.195)가
# 등록돼 있어야 함 (Workspace 관리 콘솔, 2026-08-27 완료).
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORT=587
# 발신전용 Google 그룹 주소
MAIL_FROM=notifications@acmebloc.com
