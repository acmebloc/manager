generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  googleSub String   @unique
  email     String
  name      String
  picture   String?
  // Full CRUD on every project/task/schedule site-wide, member or not.
  // Exactly one row may have this set — enforced by a partial unique index
  // added by hand in this field's migration, not expressible in this schema
  // language. Set directly in the DB; there's no UI for it.
  isSiteAdmin Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects    Project[]       @relation("ProjectOwner")
  memberships ProjectMember[]
  tasks       Task[]          @relation("TaskAssignee")
  schedules   Schedule[]      @relation("ScheduleOwner")
  oidcCodes   OidcAuthCode[]
}

model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  startAt     DateTime?
  endAt       DateTime?
  // Audit only — who clicked "create". Carries no authority: the creator
  // isn't a member unless explicitly added to `members`, same as anyone else.
  ownerId     String
  owner       User      @relation("ProjectOwner", fields: [ownerId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  members   ProjectMember[]
  tasks     Task[]
  schedules Schedule[]
}

// Who can see and touch a project, and how much. A project must always keep
// at least one 'pm' — enforced in code (projectAccess.js), not here.
model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 'member' works tasks/schedules like everyone else; 'pl' can also invite
  // and remove members (always as plain 'member' — assigning pm/pl is a 'pm'
  // -only power); 'pm' can also edit/delete the project and set anyone's role.
  role      String   @default("member")
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

model Task {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      String    @default("todo")
  assigneeId  String?
  assignee    User?     @relation("TaskAssignee", fields: [assigneeId], references: [id])
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Schedule {
  id        String    @id @default(cuid())
  projectId String?
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title     String
  startAt   DateTime
  endAt     DateTime?
  ownerId   String
  owner     User      @relation("ScheduleOwner", fields: [ownerId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// Short-lived authorization codes for our OIDC provider (used by BookStack
// and any future service that should share the Manager login). One row per
// in-flight login, deleted once exchanged for a token or expired.
model OidcAuthCode {
  code                String   @id
  userId              String
  user                User     @relation(fields: [userId], references: [id])
  clientId             String
  redirectUri          String
  codeChallenge        String?
  codeChallengeMethod  String?
  expiresAt            DateTime
  createdAt            DateTime @default(now())
}
