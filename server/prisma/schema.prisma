generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  googleSub String   @unique
  email     String
  name      String
  picture   String?
  // Full CRUD on every project/task/schedule site-wide, member or not.
  // Exactly one row may have this set — enforced by a partial unique index
  // added by hand in this field's migration, not expressible in this schema
  // language. Set directly in the DB; there's no UI for it.
  isSiteAdmin Boolean  @default(false)
  // MyPage 토글 — 꺼지면 멘션/담당자 배정/일정 참조자 알림 메일을 안 보낸다
  // (server/src/lib/notificationPrefs.js). 발송 여부만 제어할 뿐, 발송 수단
  // 자체(docs/email-notifications-spec.md)와는 무관.
  emailNotificationsEnabled Boolean @default(true)
  // 탈퇴 시각. 행을 지우는 대신 이걸 찍고 name/email/picture를 실제로 비운다 —
  // 프로젝트 생성자/일정 소유자/댓글 작성자 FK가 전부 RESTRICT라 행 삭제는
  // 애초에 불가능하고, 가능하더라도 일감의 등록자·담당자가 SET NULL로 날아가
  // "탈퇴해도 작성물은 남긴다"는 요구와 어긋난다.
  //
  // googleSub는 일부러 남긴다. 로그인이 이메일이 아니라 googleSub로 사람을
  // 찾으므로(auth.js), 같은 구글 계정으로 재가입하면 이 행을 그대로 다시 찾아
  // 활성화되고 예전 작성물의 작성자·담당자가 함께 되살아난다.
  deactivatedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects               Project[]               @relation("ProjectOwner")
  memberships            ProjectMember[]
  tasks                  Task[]                  @relation("TaskAssignee")
  reviewingTasks         Task[]                  @relation("TaskReviewer")
  createdTasks           Task[]                  @relation("TaskCreatedBy")
  taskReviews            TaskReview[]            @relation("TaskReviewAuthor")
  taskFollowing          TaskFollower[]          @relation("TaskFollowerUser")
  uploadedAttachments    TaskAttachment[]        @relation("TaskAttachmentUploader")
  taskComments           TaskComment[]           @relation("TaskCommentAuthor")
  taskCommentMentions    TaskCommentMention[]    @relation("TaskCommentMentionedUser")
  projectComments        ProjectComment[]        @relation("ProjectCommentAuthor")
  projectCommentMentions ProjectCommentMention[] @relation("ProjectCommentMentionedUser")
  schedules              Schedule[]              @relation("ScheduleOwner")
  scheduleFollowing      ScheduleFollower[]      @relation("ScheduleFollowerUser")
  oidcCodes              OidcAuthCode[]
  taskActivities         TaskActivity[]          @relation("TaskActivityActor")
  notifications          Notification[]          @relation("NotificationRecipient")
  notificationsCaused    Notification[]          @relation("NotificationActor")
}

model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  startAt     DateTime?
  endAt       DateTime?
  // Audit only — who clicked "create". Carries no authority: the creator
  // isn't a member unless explicitly added to `members`, same as anyone else.
  ownerId     String
  owner       User      @relation("ProjectOwner", fields: [ownerId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  members   ProjectMember[]
  tasks     Task[]
  schedules Schedule[]
  comments  ProjectComment[]

  // 보관(소프트 삭제) 시각. User.deactivatedAt과 같은 정신 — 행을 지우는 대신
  // 플래그만 찍는다. 목록류 조회(GET /api/projects, my-tasks, dashboard,
  // search)는 기본적으로 이 값이 null인 것만 보여주고, 이미 멤버인 사람이
  // 상세페이지에 직접 들어오는 건 막지 않는다(getProjectAccess는 이 값을
  // 보지 않음 — "목록에서 숨김"이지 "접근 차단"이 아니다). 하드 삭제(DELETE)는
  // 이것과 별개로 그대로 남아있다.
  archivedAt DateTime?

  // BookStack 공간(Shelf) 자동 연동 — 신규 프로젝트만 대상, 실패해도 프로젝트
  // 생성 자체는 막지 않는 느슨한 결합(server/src/lib/bookstack.js). null이면
  // 아직 연동 전이거나 마지막 시도가 실패한 상태 — bookstackSyncError 참고.
  bookstackShelfId   Int?
  bookstackShelfSlug String?
  bookstackBookIds   Int[]     @default([])
  bookstackRoleId    Int?
  bookstackSyncedAt  DateTime?
  bookstackSyncError String?
  // 프로비저닝 진행 중 표시 — provisionProjectSpace가 시작할 때 찍고 끝나면
  // 지운다. 이게 없으면 자동 생성이 아직 도는 중에 PM이 재시도 버튼을 눌러도
  // bookstackShelfId가 그때까진 null이라 두 번째 프로비저닝이 그대로 겹쳐
  // 돌면서 공간/문서함/역할이 중복 생성된다(check-then-act race). 오래
  // 지나도(PROVISIONING_STALE_MS) 안 지워졌으면 이전 시도가 죽은 것으로 보고
  // 다시 시도를 허용한다.
  bookstackProvisioningStartedAt DateTime?
}

// Who can see and touch a project, and how much. A project must always keep
// at least one 'pm' — enforced in code (projectAccess.js), not here.
model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 'plan'/'design'/'dev'/'other' all work tasks/schedules the same way (the
  // old single 'member' tier, now split by job function to match Task.type's
  // plan/design/dev naming); 'pl' can also invite and remove members (always
  // at one of those four — assigning pm/pl is a 'pm'-only power); 'pm' can
  // also edit/delete the project and set anyone's role.
  // 'member' is no longer assignable but old rows may still carry it — never
  // migrated in bulk, only normalized to 'other' at read time
  // (server/src/routes/projects.js's decryptMember). Keep 'member' as a rank
  // name in projectAccess.js's RANK regardless (requireProjectRole('member')
  // depends on it as a threshold, not as a real stored value).
  role      String   @default("other")
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

model ProjectComment {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("ProjectCommentAuthor", fields: [authorId], references: [id])
  body      String                       // 마크다운 원문, 평문 저장
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mentions  ProjectCommentMention[]

  @@index([projectId])
}

model ProjectCommentMention {
  id        String         @id @default(cuid())
  commentId String
  comment   ProjectComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation("ProjectCommentMentionedUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
}

model Task {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  type        String    @default("plan")   // plan | dev | design | qa
  grade       String    @default("minor")  // urgent | major | minor
  status      String    @default("todo")   // todo | doing | review | done
  // 등록자. 기존 행은 프로젝트 ownerId로 backfill. null이면 UI에 "등록자 미상"으로
  // 표시하고, 삭제 권한이 사이트 어드민에게만 남는다.
  createdById String?
  createdBy   User?     @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  assigneeId  String?
  assignee    User?     @relation("TaskAssignee", fields: [assigneeId], references: [id])
  // 검수자 1명(선택값, docs/task-review-spec.md). 담당자와 같은 사람일 수 없다 —
  // 양방향으로 서버에서 검증한다(DB 제약으로는 표현할 수 없음). 검수요청
  // (진행중→검수중)을 하려면 반드시 채워져 있어야 하고, 검수중인 일감을
  // 반려/최종완료할 수 있는 사람이기도 하다.
  reviewerId  String?
  reviewer    User?     @relation("TaskReviewer", fields: [reviewerId], references: [id])
  startAt     DateTime?
  endAt       DateTime?
  // 마감 D-3~D-day 리마인더 중 "마지막으로 보낸 날의 남은 일수"(dueReminderJob.js).
  // 매일 스캔 시점의 남은 일수와 이 값이 다르면 그날 치를 아직 안 보낸 것이라
  // 다시 보낸다 — 그래서 D-3/D-2/D-1/D-day에 한 번씩 최대 4번 보내지고, 같은
  // 날 스캔이 두 번 돌아도(재시작 등) 중복 발송은 안 된다. endAt이 바뀌면
  // (server/src/routes/tasks.js의 PATCH /:id, /:id/dates) 다시 null로 되돌려
  // 새 마감일 기준으로 사이클이 처음부터 다시 돈다.
  dueReminderLastDaysLeft Int?
  // 상위 일감(하위 작업 계층, 딱 1단계만 허용 — 서버에서 검증, DB 제약 아님).
  // 예전엔 TaskLink(type='parent')로 표시만 하고 기능 연동이 전혀 없었는데,
  // 이 필드가 그 자리를 대체한다(진행률 롤업 등 실제 기능이 붙는다).
  // 상위 일감이 삭제되면 하위 일감을 통째로 지우지 않고 그냥 최상위로 풀어준다.
  parentTaskId String?
  parentTask   Task?     @relation("TaskHierarchy", fields: [parentTaskId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  attachments    TaskAttachment[]
  comments       TaskComment[]
  linksFrom      TaskLink[]           @relation("TaskLinkFrom")
  linksTo        TaskLink[]           @relation("TaskLinkTo")
  activities     TaskActivity[]
  checklistItems TaskChecklistItem[]
  subtasks       Task[]               @relation("TaskHierarchy")
  reviews        TaskReview[]
  followers      TaskFollower[]

  @@index([projectId, status])
  @@index([assigneeId])
  @@index([reviewerId])
  @@index([endAt])
  @@index([parentTaskId])
}

// 검수 이력 — 검수요청/반려/최종완료 한 건씩. append-only로, 한 번 쓴 텍스트는
// 수정도 삭제도 되지 않는다(TaskActivity와 같은 정신). 상태 전이와 1:1로 묶여
// 있어서, 이 행 없이 검수중으로 들어가거나 검수중에서 뒤로 나오는 경로는 없다
// (docs/task-review-spec.md 4장).
//
// 차수(1차/2차 검수)는 저장하지 않고 이력 순서에서 계산한다 — kind='request'가
// 나올 때마다 1 증가하고 그 뒤의 reject/approve는 같은 차수에 속한다. 저장해두면
// 이력이 늘 때마다 두 값을 함께 맞춰야 하는데, 애초에 순서만으로 유일하게
// 결정되는 값이라 계산하는 쪽이 어긋날 여지가 없다.
model TaskReview {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation("TaskReviewAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  kind      String   // request | reject | approve
  // 검수 내용(request) 또는 반려 사유(reject). approve는 승인 기록만 남기므로 null.
  body      String?
  // 산출물 링크(최대 5개, http/https만 — 서버에서 검증). Project.bookstackBookIds와
  // 같은 Postgres 배열 컬럼: 링크마다 행을 만들 만큼의 조회 요구가 없다.
  links     String[] @default([])
  // 산출물 파일이 한 번이라도 교체·삭제된 적 있으면 true. 몇 번인지는 세지 않는다
  // (사용자 확인) — 화면엔 "산출물이 변경되었습니다" 한 줄만 붙는다. 최초 업로드는
  // 이 값을 건드리지 않고, 삭제가 일어날 때 켜진 뒤로는 다시 꺼지지 않는다.
  outputReplaced Boolean @default(false)
  createdAt DateTime @default(now())

  attachments TaskAttachment[]

  @@index([taskId, createdAt])
}

// 일감의 "참조자" — 진행 상황만 따라가는 사람들. ScheduleFollower와 동일한 조인
// 테이블 패턴이고, 프로젝트에 참여한 인원만 배정할 수 있다(서버 검증). 담당자/
// 검수자와 달리 "내 일감"에는 포함되지 않고, 등록/해제가 활동 로그에도 남지 않는다.
model TaskFollower {
  id     String @id @default(cuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation("TaskFollowerUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId])
}

// 일감 내부의 가벼운 체크리스트 — 서브태스크(위 parentTaskId)와는 무관한 별개
// 기능이다. 담당자가 자기 진행상황을 잘게 쪼개 표시하는 용도라 텍스트 수정
// 개념이 없다(추가/완료토글/삭제만) — TaskComment보다 TaskAttachment의 CRUD
// 모양에 더 가깝다.
model TaskChecklistItem {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  text      String
  done      Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([taskId, order])
}

// 일감 필드 변경 이력 — 누가 언제 무엇을 바꿨는지. TaskComment와 동일한 패턴
// (append-only, taskId cascade). description 값 자체는 저장하지 않고 변경됐다는
// 사실만 남긴다(마크다운 원문이 길어 로그가 불필요하게 커지는 걸 막기 위해) —
// field='description'일 때 fromValue/toValue는 항상 null.
model TaskActivity {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation("TaskActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  action    String   // created | field_changed
  field     String?  // title | type | grade | status | assigneeId | startAt | endAt | description
  fromValue String?
  toValue   String?
  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
}

// 인앱 알림(알림벨) — 담당자 지정/멘션/일정 참조자/마감 임박 이벤트 발생 시
// 이메일과 별도로 항상 적재된다(이메일은 emailNotificationsEnabled로 껐다 켰다
// 할 수 있지만, 인앱 알림은 별도 토글 없이 항상 생성됨).
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  type      String    // task_assigned | task_mention | project_mention | schedule_follower | task_due_soon
  title     String
  link      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

// 일감 간 순수 관계 표시용 — 상태 등 어떤 기능도 연동되지 않는다. 대칭 관계라
// 어느 쪽에서 만들어도 fromTaskId/toTaskId 양쪽에서 조회된다. 여러 개 허용,
// 같은 프로젝트 내로만 제한(코드 레벨 검증).
//
// 예전엔 'parent'/'related' 두 타입이었는데, 'parent'(부모/자식 표시)는 실제
// 기능(진행률 롤업 등)이 있는 Task.parentTaskId 계층으로 대체되고 정리됐다 —
// 그 마이그레이션의 데이터 이관은 prisma/migrations의 관련 마이그레이션 SQL
// 참고. 지금은 'related' 타입만 실제로 쓰인다(과거 데이터에 'parent' 값이
// 남아있으면 안 되지만, 컬럼 자체는 임의 문자열이라 스키마 레벨 제약은 없다).
model TaskLink {
  id         String   @id @default(cuid())
  fromTaskId String
  fromTask   Task     @relation("TaskLinkFrom", fields: [fromTaskId], references: [id], onDelete: Cascade)
  toTaskId   String
  toTask     Task     @relation("TaskLinkTo", fields: [toTaskId], references: [id], onDelete: Cascade)
  type       String   // related (과거 parent는 마이그레이션으로 정리됨)
  createdAt  DateTime @default(now())

  @@unique([fromTaskId, toTaskId, type])
  @@index([toTaskId, type])
}

model TaskAttachment {
  id           String   @id @default(cuid())
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileName     String                     // 사용자에게 보여줄 원본 파일명
  mimeType     String
  size         Int
  storageKey   String   @unique           // 디스크상의 이름. 확장자 없음
  uploadedById String?
  uploadedBy   User?    @relation("TaskAttachmentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  // 검수 이력에 딸린 산출물 파일이면 그 이력을 가리킨다. null이면 일감의 일반
  // 첨부파일 — 첨부파일 목록/개수는 항상 `reviewId: null`로 걸러서, 산출물이
  // 첨부파일 목록에 섞여 보이지 않게 한다. 이렇게 테이블을 나누지 않고 재사용하는
  // 이유는 20MB 상한·확장자 허용목록·업로드/다운로드 권한 검사를 그대로
  // 물려받기 위해서다(docs/task-review-spec.md 3장).
  reviewId     String?
  review       TaskReview? @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([taskId])
  @@index([reviewId])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("TaskCommentAuthor", fields: [authorId], references: [id])
  body      String                       // 마크다운 원문, 평문 저장
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mentions  TaskCommentMention[]

  @@index([taskId])
}

model TaskCommentMention {
  id        String      @id @default(cuid())
  commentId String
  comment   TaskComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation("TaskCommentMentionedUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
}

model Schedule {
  id        String    @id @default(cuid())
  projectId String?
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title     String
  startAt   DateTime
  endAt     DateTime?
  ownerId   String
  owner     User      @relation("ScheduleOwner", fields: [ownerId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // 반복 규칙 — 둘 다 있으면 이 레코드는 "시리즈 정의"고, 실제 화면에 뜨는
  // 회차들은 저장되지 않고 매 조회마다 startAt을 intervalWeeks*7일씩 밀며
  // 계산된다(server/src/lib/scheduleRecurrence.js). 회차 하나만 따로
  // 수정/삭제된 경우만 ScheduleOccurrenceOverride로 예외를 둔다.
  recurrenceIntervalWeeks Int?
  recurrenceEndAt         DateTime?

  followers ScheduleFollower[]
  overrides ScheduleOccurrenceOverride[]
}

// 반복 시리즈의 특정 회차 하나만 다른 날짜/제목으로 바뀌었거나(override) 통째로
// 건너뛰기(deleted=true, "이 회차만 삭제")된 경우에만 존재하는 예외 레코드.
// 참조자는 회차별로 나뉘지 않고 항상 시리즈(Schedule.followers)를 그대로 따른다.
model ScheduleOccurrenceOverride {
  id              String    @id @default(cuid())
  scheduleId      String
  schedule        Schedule  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  occurrenceIndex Int
  deleted         Boolean   @default(false)
  title           String?
  startAt         DateTime?
  endAt           DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([scheduleId, occurrenceIndex])
}

// 일정의 "참조자" — 팔로우업 해야 하는 사람들. 프로젝트 일정은 프로젝트 멤버
// 중에서, 개인 일정은 전체 사용자 중에서 고른다. TaskCommentMention과 동일한
// 조인 테이블 패턴.
model ScheduleFollower {
  id         String   @id @default(cuid())
  scheduleId String
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation("ScheduleFollowerUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, userId])
}

// Short-lived authorization codes for our OIDC provider (used by BookStack
// and any future service that should share the Manager login). One row per
// in-flight login, deleted once exchanged for a token; codes that expire
// unexchanged are swept by the next /authorize (oidc.js), since that's the
// only place rows are created and logins are frequent enough to keep up.
model OidcAuthCode {
  code                String   @id
  userId              String
  user                User     @relation(fields: [userId], references: [id])
  clientId             String
  redirectUri          String
  codeChallenge        String?
  codeChallengeMethod  String?
  expiresAt            DateTime
  createdAt            DateTime @default(now())
}
